# Configuración del Backend (FastAPI)
PORT=8080
HOST=0.0.0.0
ENV=development

# Base de Datos PostgreSQL / SQLite Fallback
DATABASE_URL=postgresql://usuario_db:password_db@localhost:5432/invictory_db

# Proveedores de Inteligencia Artificial (Multimodal)
# OpenAI Whisper STT: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_openai_api_key_aqui

# DeepSeek Vision OCR & LLM: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Telegram MiniApp Config & Bot Token: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
BACKEND_CORS_ORIGINS=["http://localhost:5180","http://localhost:5173","https://web.telegram.org"]

# Detección de Anomalías (Umbrales Configurables)
# Porcentaje de desviación mínimo para generar alerta (ej: 50 = alerta si >50% de diferencia)
ANOMALY_THRESHOLD_PERCENT=50.0
# Diferencia absoluta mínima para considerar anomalía (evita alertas por decimales)
ANOMALY_MIN_ABSOLUTE_DIFF=2.0

