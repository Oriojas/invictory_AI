# URL base del backend. Por defecto VACÍO = mismo origen (recomendado):
#   - dev: el proxy de Vite reenvía /api -> http://localhost:8080
#   - prod (Railway): server.js reenvía /api -> backend privado
# Solo defínela si necesitas apuntar a un backend absoluto (p. ej. túnel externo).
VITE_API_BASE_URL=

# --- Variables del servidor de producción (server.js) — NO son VITE_, se leen en runtime ---
# URL interna del backend privado en Railway (proxy /api). Ej: http://backend.railway.internal:8080
BACKEND_INTERNAL_URL=
# Bot token de Telegram: activa la validación de initData en el proxy (solo la Mini App real pasa).
# Sin este valor, el proxy NO fuerza auth (útil en dev local, inseguro en prod).
TELEGRAM_BOT_TOKEN=
# Antigüedad máxima del initData en segundos (anti-replay). Def. 86400 (24h).
INITDATA_MAX_AGE_SECONDS=86400
